{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue Monitor Indonesian TTS API",
    "description": "API TTS Bahasa Indonesia gratis, cepat (in-memory tanpa simpan file ke disk), suara seragam ala MRT Jakarta, dan kompatibel langsung dengan SoundOfText.",
    "version": "3.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/tts": {
      "post": {
        "summary": "Create Tts Stream",
        "description": "Generate audio in memory and return audio bytes directly (no disk storage).",
        "operationId": "create_tts_stream_tts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TTSRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sounds": {
      "post": {
        "summary": "Soundoftext Generate",
        "description": "Drop-in replacement for SoundOfText `POST /sounds` (in-memory only).",
        "operationId": "soundoftext_generate_sounds_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SoundOfTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoundOfTextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sounds/{sound_id}.mp3": {
      "get": {
        "summary": "Soundoftext Download Under Sounds",
        "operationId": "soundoftext_download_under_sounds_sounds__sound_id__mp3_get",
        "parameters": [
          {
            "name": "sound_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sound Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/{sound_id}.mp3": {
      "get": {
        "summary": "Soundoftext Download Root",
        "operationId": "soundoftext_download_root__sound_id__mp3_get",
        "parameters": [
          {
            "name": "sound_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sound Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SoundOfTextData": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "voiceName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voicename"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SoundOfTextData"
      },
      "SoundOfTextRequest": {
        "properties": {
          "engine": {
            "type": "string",
            "title": "Engine",
            "default": "Google"
          },
          "data": {
            "$ref": "#/components/schemas/SoundOfTextData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SoundOfTextRequest"
      },
      "SoundOfTextResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "success",
          "id"
        ],
        "title": "SoundOfTextResponse"
      },
      "TTSRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "description": "Kalimat atau nama lengkap yang akan diucapkan."
          },
          "voice": {
            "type": "string",
            "enum": [
              "mrt_female",
              "mrt_male",
              "offline"
            ],
            "title": "Voice"
          },
          "chime": {
            "type": "boolean",
            "title": "Chime"
          },
          "format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav"
            ],
            "title": "Format",
            "default": "mp3"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TTSRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}